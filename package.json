{
  "name": "sme-erp",
  "version": "0.1.0",
  "description": "소규모 제조업을 위한 경량 오픈소스 ERP (Electron + SQLite, 로컬 퍼스트)",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "build:win": "electron-builder --win --config electron-builder.yml",
    "build:win:dir": "electron-builder --win --dir --config electron-builder.yml",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:phase0": "node --test tests/unit/security/hasher.test.js tests/unit/db/sqliteEngine.test.js tests/unit/services/onboardingService.test.js",
    "test:runtime": "ELECTRON_RUN_AS_NODE=1 electron --test tests/smoke/electronRuntime.test.js",
    "test:e2e": "node --test \"tests/integration/**/*.test.js\""
  },
  "author": "SME-ERP Contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.smeerp.app",
    "productName": "SME-ERP",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {}
}
