{
  "name": "branch-erp",
  "version": "0.1.0",
  "description": "지점 관리 프로그램 (구 DAWIN 대체)",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "build:win": "electron-builder --win --config electron-builder.yml",
    "build:win:dir": "electron-builder --win --dir --config electron-builder.yml",
    "seed:sample": "npx tsx scripts/seed-sample.ts",
    "seed:sample:dry": "npx tsx scripts/seed-sample.ts --dry-run"
  },
  "author": "GenSystem",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.0"
  },
  "build": {
    "appId": "com.gensystem.branch-erp",
    "productName": "지점관리프로그램",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
